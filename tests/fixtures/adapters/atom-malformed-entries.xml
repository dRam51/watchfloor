<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-built (not captured from a live source) fixture for
  tests/adapters/rss.test.ts -- the Atom-format counterpart of
  rss-malformed-entries.xml. Mixes well-formed <entry> elements with
  individually-defective ones inside an otherwise well-formed Atom document,
  and also exercises two Atom-specific shapes the four live fixtures don't
  fully cover on their own: an entry with more than one <link> (must pick
  rel="alternate", not just the first), and an entry with its own <author>
  overriding the feed-level default.
-->
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Malformed Atom fixture</title>
  <link href="https://example.test/atom" rel="self"/>
  <id>https://example.test/atom</id>
  <updated>2026-08-12T12:00:00+00:00</updated>
  <author><name>Feed-Level Author</name></author>

  <entry>
    <title>Good Entry One</title>
    <link href="https://example.test/entries/good-one" rel="alternate"/>
    <published>2026-08-11T21:28:35+00:00</published>
    <id>https://example.test/entries/good-one</id>
    <summary type="html">A perfectly normal entry, no entry-level author -- must inherit the feed's.</summary>
  </entry>

  <entry>
    <!-- no <link> at all: must be dropped -->
    <title>Missing Link</title>
    <published>2026-08-11T21:28:35+00:00</published>
    <id>urn:example:missing-link</id>
    <summary type="html">This entry has no link and must be skipped.</summary>
  </entry>

  <entry>
    <!-- <title> present but empty: must be dropped -->
    <title></title>
    <link href="https://example.test/entries/empty-title" rel="alternate"/>
    <summary type="html">This entry has an empty title and must be skipped.</summary>
  </entry>

  <entry>
    <title>Unparseable Date Survives</title>
    <link href="https://example.test/entries/bad-date" rel="alternate"/>
    <published>not a real date at all</published>
    <id>https://example.test/entries/bad-date</id>
    <summary type="html">
      Must survive with publishedAt passed through VERBATIM as the raw,
      unparseable string -- deciding whether a date parses is
      normalizeItem's job, not this adapter's.
    </summary>
  </entry>

  <entry>
    <title>Good Entry With Multiple Links</title>
    <link href="https://example.test/entries/replies" rel="replies"/>
    <link href="https://example.test/entries/good-multi-link" rel="alternate"/>
    <published>2026-08-12T09:00:00+00:00</published>
    <id>https://example.test/entries/good-multi-link</id>
    <summary type="html">Two &lt;link&gt; elements -- must resolve to the rel="alternate" one, not the first one in document order.</summary>
  </entry>

  <entry>
    <title>Good Entry With Own Author</title>
    <link href="https://example.test/entries/own-author" rel="alternate"/>
    <published>2026-08-12T10:00:00+00:00</published>
    <id>https://example.test/entries/own-author</id>
    <author><name>Entry-Level Author</name></author>
    <summary type="html">Entry-level author must override the feed-level default.</summary>
  </entry>

  <entry>
    <title>Good Entry Three</title>
    <link href="https://example.test/entries/good-three" rel="alternate"/>
    <!-- no <published> or <updated> at all: fine, publishedAt is simply null -->
    <id>https://example.test/entries/good-three</id>
    <summary type="html">No date fields at all -- still a valid entry.</summary>
  </entry>

  <entry>
    <title>Blank Link Href</title>
    <!-- href present but blank after the XML layer trims it: same as missing -->
    <link href="   " rel="alternate"/>
    <id>urn:example:blank-href</id>
    <summary type="html">Link element is present but its href is blank -- must be skipped.</summary>
  </entry>

  <entry>
    <!-- no <published> at all: publishedAt must fall back to <updated>
         rather than staying null when a date IS available (fix round 1,
         Finding 4). <updated> is REQUIRED on every Atom entry, so this is
         the one date field guaranteed present when <published> is not. -->
    <title>Updated Only Fallback</title>
    <link href="https://example.test/entries/updated-only-fallback" rel="alternate"/>
    <updated>2026-08-10T00:00:00+00:00</updated>
    <id>https://example.test/entries/updated-only-fallback</id>
    <summary type="html">No published element -- publishedAt must fall back to updated.</summary>
  </entry>

  <entry>
    <!-- no <summary> at all, only <content> (fix round 1, Finding 4). -->
    <title>Content Only Fallback</title>
    <link href="https://example.test/entries/content-only-fallback" rel="alternate"/>
    <published>2026-08-12T11:00:00+00:00</published>
    <id>https://example.test/entries/content-only-fallback</id>
    <content type="html">Full content, no summary element on this entry at all.</content>
  </entry>

  <entry>
    <!-- ONLY a rel="enclosure" link (a podcast-style attachment), no
         rel="alternate" and no rel-less link to default to alternate.
         Must be DROPPED, not resolved to a knowingly-wrong URL -- fix
         round 1, Finding 5: canonical_url feeds item_key, which is
         permanent under append-only storage. -->
    <title>Only Non-Alternate Link</title>
    <link href="https://example.test/entries/podcast.mp3" rel="enclosure" type="audio/mpeg"/>
    <id>urn:example:only-enclosure</id>
    <summary type="html">Only a rel="enclosure" link, no alternate -- must be skipped.</summary>
  </entry>

  <entry>
    <!-- BOTH <summary> and <content> present, with DIFFERENT text (fix
         round 1, mutation-testing follow-up): proves summary is actually
         PREFERRED, not merely that content is used when summary is
         absent. -->
    <title>Both Summary And Content Present</title>
    <link href="https://example.test/entries/both-summary-content" rel="alternate"/>
    <published>2026-08-12T12:30:00+00:00</published>
    <id>https://example.test/entries/both-summary-content</id>
    <summary type="html">Preferred summary text.</summary>
    <content type="html">Should-lose full content text.</content>
  </entry>

  <entry>
    <!-- BOTH <published> and <updated> present, with DIFFERENT values (fix
         round 1, mutation-testing follow-up): the live Simon Willison
         fixture has both fields on every entry, but always IDENTICAL, which
         cannot distinguish precedence -- this proves published is actually
         preferred, not merely present. -->
    <title>Both Published And Updated Present</title>
    <link href="https://example.test/entries/both-dates" rel="alternate"/>
    <published>2026-08-01T00:00:00+00:00</published>
    <updated>2026-08-12T00:00:00+00:00</updated>
    <id>https://example.test/entries/both-dates</id>
    <summary type="html">Both published and updated present with different values -- published must win.</summary>
  </entry>

</feed>
