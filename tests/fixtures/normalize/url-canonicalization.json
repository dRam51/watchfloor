[
  {
    "note": "scheme+host lowercasing, path case preserved",
    "input": "HTTPS://ExAmPle.COM/Path/To/Article",
    "expected": "https://example.com/Path/To/Article"
  },
  {
    "note": "strip www",
    "input": "https://www.example.com/foo",
    "expected": "https://example.com/foo"
  },
  {
    "note": "drop fragment",
    "input": "https://example.com/foo#section-2",
    "expected": "https://example.com/foo"
  },
  {
    "note": "tracking params stripped, rest sorted",
    "input": "https://example.com/foo?z=1&utm_source=newsletter&a=2",
    "expected": "https://example.com/foo?a=2&z=1"
  },
  {
    "note": "fbclid + gclid stripped",
    "input": "https://example.com/foo?gclid=abc123&fbclid=xyz789&id=42",
    "expected": "https://example.com/foo?id=42"
  },
  {
    "note": "mailchimp mc_cid/mc_eid stripped, empty query removed",
    "input": "https://example.com/foo?mc_cid=abc123&mc_eid=def456",
    "expected": "https://example.com/foo"
  },
  {
    "note": "ref + source stripped",
    "input": "https://example.com/foo?ref=homepage&source=twitter&id=9",
    "expected": "https://example.com/foo?id=9"
  },
  {
    "note": "at_* stripped",
    "input": "https://example.com/foo?at_medium=email&at_campaign=weekly&x=1",
    "expected": "https://example.com/foo?x=1"
  },
  {
    "note": "trailing slash stripped on non-root",
    "input": "https://example.com/foo/",
    "expected": "https://example.com/foo"
  },
  {
    "note": "root path preserved as slash",
    "input": "https://example.com/",
    "expected": "https://example.com/"
  },
  {
    "note": "bare host gets root slash",
    "input": "https://example.com",
    "expected": "https://example.com/"
  },
  {
    "note": "multiple trailing slashes collapse to none (idempotence-critical)",
    "input": "https://example.com/foo//",
    "expected": "https://example.com/foo"
  },
  {
    "note": "force https for known-https host",
    "input": "http://arxiv.org/abs/2508.01234",
    "expected": "https://arxiv.org/abs/2508.01234"
  },
  {
    "note": "unknown host: scheme left alone, not forced",
    "input": "http://some-obscure-blog.example/post/1",
    "expected": "http://some-obscure-blog.example/post/1"
  },
  {
    "note": "google news redirect url left alone structurally, generic rules still apply",
    "input": "HTTPS://News.Google.com/rss/articles/CBMixyz123ABC?oc=5#x",
