    "expected": "https://arxiv.org/abs/2508.01234v2"
  },
  {
    "note": "repeated query key: stable sort keeps relative order",
    "input": "https://example.com/foo?b=2&a=1&b=1",
    "expected": "https://example.com/foo?a=1&b=2&b=1"
  },
  {
    "note": "nvd cve detail url passthrough",
