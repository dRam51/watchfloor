{
  "name": "watchfloor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "backup": "node --env-file=.env src/bin/backup.ts",
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run build && npm run build:web",
    "build:web": "vite build",
    "check:portability": "node scripts/check-portability.mjs",
    "dev": "node --watch --env-file=.env src/bin/api.ts",
    "dev:web": "node --env-file=.env node_modules/vite/bin/vite.js",
    "ingest": "node --env-file=.env src/bin/ingest.ts",
    "mcp": "node --env-file=.env src/bin/mcp.ts",
    "migrate": "node --env-file=.env src/bin/migrate.ts",
    "preview:web": "node --env-file=.env node_modules/vite/bin/vite.js preview",
    "rank": "node --env-file=.env src/bin/rank.ts",
    "scheduler": "node --env-file=.env src/bin/scheduler.ts",
    "score": "node --env-file=.env src/bin/score.ts",
    "score:force": "node --env-file=.env src/bin/score.ts --force",
    "start": "node --env-file=.env dist/bin/api.js",
    "suggest": "node --env-file=.env src/bin/suggest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p web/tsconfig.json",
    "vault": "node --env-file=.env src/bin/vault.ts",
    "watchfloor": "node --env-file=.env src/bin/watchfloor.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.2.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "maplibre-gl": "^6.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
